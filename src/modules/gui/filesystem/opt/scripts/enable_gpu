#!/bin/bash

# Skip the legacy GPU acceleration setup on boards where vc4/KMS is already the
# default (Pi 4/5). Detect the board via /proc/device-tree/model: it exists on
# both 32- and 64-bit kernels, while /proc/cpuinfo "Revision" is missing on
# several arm64 kernels. When Revision was absent, the old arithmetic below
# silently failed ($((0x & 0xffff))), the Pi 5 was misdetected as "Pi 3 or
# older", and the legacy path ran: cmdline quiet/splash stripped, duplicate
# dtoverlay=vc4-kms-v3d appended, and an unconditional `shutdown -r now` --
# an avoidable first-boot reboot on FullPageOS #708.
if [ ! -f /etc/gpu_enabled ]; then
    model="$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)"
    case "$model" in
        "Raspberry Pi 4"*|"Raspberry Pi 400"*|"Raspberry Pi Compute Module 4"*|\
        "Raspberry Pi 5"*|"Raspberry Pi Compute Module 5"*)
            reason="vc4/KMS acceleration is the default on $model; legacy GPU setup skipped"
            echo "enable_gpu: $model detected; $reason"
            {
                printf 'status=already-enabled\n'
                printf 'reason=%s\n' "$reason"
                printf 'model=%s\n' "$model"
            } | sudo tee /etc/gpu_enabled >/dev/null
            exit 0
            ;;
    esac

    echo "enable_gpu: legacy board detected (${model:-unknown model}), enabling GPU acceleration"

    # Revision is only used for the Pi 4 rev 1.1/1.2 special case below; keep the
    # parse defensive so an empty value can never break the script.
    check="$(awk -F': ' '/^Revision/{print $2}' /proc/cpuinfo 2>/dev/null | tr -d ' ' | sed -e 's/[a-c]//' || true)"

    sudo sed 's@matchbox-window-manager \&@compton -b -d :0 --backend glx --unredir-if-possible --glx-swap-method buffer-age --glx-no-stencil --paint-on-overlay --vsync opengl \nmatchbox-window-manager \&@g' -i /opt/custompios/scripts/start_gui
    sudo sed -i /boot/firmware/cmdline.txt -e "s/ quiet//"
    sudo sed -i /boot/firmware/cmdline.txt -e "s/ splash//"
    sudo sed -i /boot/firmware/cmdline.txt -e "s/ plymouth.ignore-serial-consoles//"
    if [ "${check}" != "03111" ] && [ "${check}" != "03112" ]; then
        sudo sed -i /boot/firmware/config.txt -e "s/^\#dtoverlay=vc4-kms-v3d/dtoverlay=vc4-kms-v3d/"
        printf "dtoverlay=vc4-kms-v3d\n" | sudo tee -a /boot/firmware/config.txt
    fi
    sudo sed -i /boot/firmware/config.txt -e "s/^gpu_mem/\#gpu_mem/"
    touch /etc/gpu_enabled
    sudo shutdown -r now
fi
