#!/bin/bash

# Compatibility with existing enable_gpu_first_boot.service units.
if [ "${1:-}" != "--session" ]; then
    echo "enable_gpu: compositor setup runs with the GUI session"
    exit 0
fi

# Select the compositor for the current board.
model="$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
case "$model" in
    "Raspberry Pi 2 Model "*|"Raspberry Pi 3 Model "*|\
    "Raspberry Pi Compute Module 3"*|"Raspberry Pi Zero 2 "*) ;;
    *) exit 0 ;;
esac

# GLX requires a bound vc4 DRM driver.
for driver in /sys/class/drm/card*/device/driver; do
    if [ "$(basename "$(readlink -f "$driver")")" = "vc4" ]; then
        if command -v compton >/dev/null 2>&1; then
            compton -b -d "${DISPLAY:-:0}" --backend glx --unredir-if-possible \
                --glx-swap-method buffer-age --glx-no-stencil --paint-on-overlay --vsync opengl
        fi
        exit 0
    fi
done
